# Core runtime
TZ=America/New_York

# Open WebUI image
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.0

# Open WebUI app settings
OPENWEBUI_PORT=3000

# Open WebUI secrets
# Generate once with openssl rand -hex 32 and keep unchanged across deployments.
OPENWEBUI_SECRET_KEY=
# Create a dedicated LiteLLM virtual key; do not use LITELLM_MASTER_KEY.
OPENWEBUI_LITELLM_API_KEY=

# SearXNG image
SEARXNG_IMAGE=docker.io/searxng/searxng:2026.11.2-cccbc9e15@sha256:892ed5710603e38f9dc201e6a0b2f3f14dbdb8108edcadac30e55b165c979fb7

# SearXNG secret (not an API authentication key)
# Generate once with openssl rand -hex 32 and keep unchanged across deployments.
SEARXNG_SECRET=

# LiteLLM images
# Pinned development release for native OpenCode Go support.
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.109.0-dev.2
LITELLM_DB_IMAGE=postgres:16

# LiteLLM app settings
LITELLM_PORT=4000
LITELLM_ADMIN_USERNAME=admin
LITELLM_ADMIN_PASSWORD=

# LiteLLM secrets (generate unique values before deploying)
# Keep the salt key unchanged after deployment; it encrypts stored credentials.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Database settings
LITELLM_DB_USER=litellm
# Use URL-safe characters because this password is embedded in DATABASE_URL.
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm

# App config paths
LITELLM_CONFIG_PATH=./config/config.yaml
SEARXNG_CONFIG_PATH=./config/searxng/settings.yml

# App data paths
OPENWEBUI_DATA_PATH=/var/lib/komodo/stacks/ai/appdata/open-webui
LITELLM_DB_DATA_PATH=/var/lib/komodo/stacks/ai/appdata/postgres
SEARXNG_DATA_PATH=/var/lib/komodo/stacks/ai/appdata/searxng
