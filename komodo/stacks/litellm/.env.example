# Core runtime
TZ=America/New_York

# Open WebUI image
OPENWEBUI_IMAGE=ghcr.io/open-webui/open-webui:v0.13.0

# Open WebUI app settings
OPENWEBUI_PORT=3000

# Open WebUI secrets
# Generate once with openssl rand -hex 32 and keep unchanged across deployments.
OPENWEBUI_SECRET_KEY=
# Create a dedicated LiteLLM virtual key; do not use LITELLM_MASTER_KEY.
OPENWEBUI_LITELLM_API_KEY=

# LiteLLM images
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6
LITELLM_DB_IMAGE=postgres:16

# LiteLLM app settings
LITELLM_PORT=4000
LITELLM_ADMIN_USERNAME=admin
LITELLM_ADMIN_PASSWORD=

# LiteLLM secrets (generate unique values before deploying)
# Keep the salt key unchanged after deployment; it encrypts stored credentials.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Database settings
LITELLM_DB_USER=litellm
# Use URL-safe characters because this password is embedded in DATABASE_URL.
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm

# App config paths
LITELLM_CONFIG_PATH=./config/config.yaml

# App data paths
OPENWEBUI_DATA_PATH=/var/lib/komodo/stacks/litellm/appdata/open-webui
LITELLM_DB_DATA_PATH=/var/lib/komodo/stacks/litellm/appdata/postgres
