# Core runtime
TZ=America/New_York

# LiteLLM images
LITELLM_IMAGE=ghcr.io/berriai/litellm:v1.106.6
LITELLM_DB_IMAGE=postgres:16

# LiteLLM app settings
LITELLM_PORT=4000
LITELLM_ADMIN_USERNAME=admin
LITELLM_ADMIN_PASSWORD=

# LiteLLM secrets (generate unique values before deploying)
# Keep the salt key unchanged after deployment; it encrypts stored credentials.
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=

# Database settings
LITELLM_DB_USER=litellm
# Use URL-safe characters because this password is embedded in DATABASE_URL.
LITELLM_DB_PASSWORD=
LITELLM_DB_NAME=litellm

# App config paths
LITELLM_CONFIG_PATH=./config/config.yaml

# App data paths
LITELLM_DB_DATA_PATH=/var/lib/komodo/stacks/litellm/appdata/postgres
